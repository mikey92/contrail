{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["esnext"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}

{
  "name": "contrail",
  "version": "0.1.0",
  "private": true,
  "description": "Air traffic control for coding agents: the next GitHub, built on Cloudflare Workers and Artifacts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikey92/contrail.git"
  },
  "homepage": "https://contrail.mikey9220.workers.dev",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "dev:ui": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "isomorphic-git": "^1.43.0",
    "node-diff3": "^3.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.20.5",
    "d3-hierarchy": "^3.1.2",
    "playwright": "^1.63.0",
    "preact": "^11.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}
